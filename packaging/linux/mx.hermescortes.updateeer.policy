<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- The administrator shell Updateeer keeps open while it runs. `auth_admin_keep` makes polkit
     remember the password for a few minutes, so a shell that has to be restarted (after a failed
     or cancelled command) does not ask again right away. -->
<policyconfig>
  <vendor>Updateeer</vendor>
  <vendor_url>https://github.com/hermescortesm/updateeer</vendor_url>
  <action id="mx.hermescortes.updateeer.root">
    <description>Update software with Updateeer</description>
    <description xml:lang="es">Actualizar software con Updateeer</description>
    <description xml:lang="pt">Atualizar software com o Updateeer</description>
    <description xml:lang="fr">Mettre à jour des logiciels avec Updateeer</description>
    <description xml:lang="de">Software mit Updateeer aktualisieren</description>
    <description xml:lang="ja">Updateeer でソフトウェアを更新する</description>
    <description xml:lang="zh">使用 Updateeer 更新软件</description>
    <message>Authentication is required to update software with Updateeer</message>
    <message xml:lang="es">Se necesita autenticación para actualizar software con Updateeer</message>
    <message xml:lang="pt">É necessária autenticação para atualizar software com o Updateeer</message>
    <message xml:lang="fr">Une authentification est requise pour mettre à jour des logiciels avec Updateeer</message>
    <message xml:lang="de">Zum Aktualisieren von Software mit Updateeer ist eine Authentifizierung erforderlich</message>
    <message xml:lang="ja">Updateeer でソフトウェアを更新するには認証が必要です</message>
    <message xml:lang="zh">使用 Updateeer 更新软件需要认证</message>
    <icon_name>updateeer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/updateeer</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--root-shell</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
